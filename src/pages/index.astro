---
import BaseLayout from '../layouts/BaseLayout.astro';
import Shot from '../components/Shot.astro';
import ShotDeck from '../components/ShotDeck.astro';
import { site } from '../config/site';

type Gutter = 'l' | 'r';

// Shot intrinsic dimensions (post-crop, from the pipeline) — passed through so
// the browser reserves space and nothing shifts as images lazy-load.
const dims = {
  workspaces: { w: 1600, h: 1030 },
  agents: { w: 1600, h: 1039 },
  access: { w: 1600, h: 1017 },
  firewall: { w: 1600, h: 1037 },
  approvals: { w: 1600, h: 1031 },
  trail: { w: 1600, h: 1039 },
  schedules: { w: 1600, h: 1031 },
  // Full-Ubuntu-desktop proof shots (Claude running inside the governed VM).
  claudeDesktop: { w: 1600, h: 837 },
  claudeBrowser: { w: 1600, h: 962 },
};

// The six non-hero shots, folded into one tabbed deck. Every alt/caption/callout
// string here is part of the page's locked copy (see scripts/qa-static.mjs) and
// stays in the DOM regardless of which tab is visible.
const deckShots: {
  id: string;
  slug: string;
  label: string;
  width: number;
  height: number;
  alt: string;
  caption: string;
  callouts?: { x: number; y: number; text: string; gutter?: Gutter }[];
}[] = [
  {
    id: 'agents',
    slug: 'agents.png',
    label: 'Agents',
    width: dims.agents.w,
    height: dims.agents.h,
    alt: 'The AI agents panel: Claude, OpenAI, and Hermes client options, each described as routed through its own governed LemmaComputer identity, plus a default model mode selector — Auto, Lite, Balanced, Pro.',
    caption: 'AI agents — a separate governed identity, model grant, and tool scope per client',
    callouts: [
      { x: 15, y: 24, text: 'Claude', gutter: 'l' },
      { x: 50, y: 24, text: 'OpenAI · coming soon', gutter: 'l' },
      { x: 84, y: 40, text: 'Hermes · governed client', gutter: 'r' },
    ],
  },
  {
    id: 'computer-shot',
    slug: 'access.png',
    label: 'Computer',
    width: dims.access.w,
    height: dims.access.h,
    alt: 'The Create workspace screen showing two access modes — Managed workspace (organization managed, policy-approved tools and destinations only) and Disposable open workspace (non-sensitive work only, inside the isolated Kasm boundary) — with Firefox ESR listed as a managed browser locked to the governed egress proxy.',
    caption: 'Workspace access — Managed vs. Disposable open, inside the Kasm boundary',
    callouts: [
      { x: 28, y: 49, text: 'Managed · org-approved', gutter: 'l' },
      { x: 74, y: 49, text: 'Disposable · Kasm boundary', gutter: 'r' },
      { x: 30, y: 88, text: 'browser → egress proxy', gutter: 'l' },
    ],
  },
  {
    id: 'firewall',
    slug: 'firewall.png',
    label: 'Firewall',
    width: dims.firewall.w,
    height: dims.firewall.h,
    alt: 'The Create security group dialog for the egress firewall: a reusable set of Allow and Deny rules whose default behavior is set to Deny unmatched destinations, with an Allow rule for an HTTPS destination on port 443.',
    caption: 'Egress firewall — reusable Allow/Deny groups, deny-unmatched by default',
    callouts: [{ x: 20, y: 42, text: 'deny unmatched', gutter: 'l' }],
  },
  {
    id: 'approvals',
    slug: 'approvals.png',
    label: 'Approvals',
    width: dims.approvals.w,
    height: dims.approvals.h,
    alt: 'The Tools & approvals screen for a connected service, showing an organization tool policy with a version hash, per-tool Allow controls, and a note that approval rules are enforced in Control, not trusted to the desktop client. New or changed tools stay blocked until the exact definition is saved.',
    caption: 'Tools & approvals — new or changed tools stay blocked until reviewed',
    callouts: [
      { x: 88, y: 39, text: 'policy hash', gutter: 'r' },
      { x: 26, y: 88, text: 'enforced in Control', gutter: 'l' },
    ],
  },
  {
    id: 'trail',
    slug: 'trail.png',
    label: 'Trail',
    width: dims.trail.w,
    height: dims.trail.h,
    alt: 'The Trail screen — protected action history — showing an approval device that can sign protected actions only after a deliberate biometric, PIN, or security-key confirmation, above a timeline of verified workspace events.',
    caption: 'Trail — protected actions require a local confirmation on an enrolled device',
    callouts: [
      { x: 24, y: 33, text: 'approval device', gutter: 'l' },
      { x: 22, y: 78, text: 'signed events', gutter: 'l' },
    ],
  },
  {
    id: 'schedules-shot',
    slug: 'schedules.png',
    label: 'Schedules',
    width: dims.schedules.w,
    height: dims.schedules.h,
    alt: 'The Create schedule dialog for a scheduled agent prompt, binding a workspace and agent to a recurring time, with a note that LemmaComputer will re-check the workspace, agent, and current policy before every run.',
    caption: 'Create schedule — re-checks workspace, agent, and policy before every run',
    callouts: [{ x: 62, y: 30, text: 're-check before every run', gutter: 'r' }],
  },
];

---

<BaseLayout
  title="LemmaComputer — Governed computer for AI agents | Any agent, one sandbox"
  path="/"
>
  {/* Fixed backdrop: three depth planes of drifting governance artifacts
      (signed hashes, costs, timestamps, verdict glyphs, tiny socket/lock/shield
      motifs). Injected + parallaxed + velocity-blurred by initArtifacts() in
      motion.ts. Purely decorative, behind everything (z-index:0), and absent
      under reduced motion. Faint ink-on-paper on this light surface. */}
  <div id="artifacts" aria-hidden="true">
    <div class="depth" id="d1"></div><div class="depth" id="d2"></div><div class="depth" id="d3"></div>
  </div>

  {/* Scroll-progress hairline — decorative, driven by ScrollTrigger. */}
  <div class="scrollbar" id="scrollbar" aria-hidden="true"></div>

  <!-- NAV — same fixed, difference-blend bar as LemmaResearch; frosts on scroll. -->
  <nav class="nav" id="nav">
    <a class="mark" href="#top">LEMMACOMPUTER<span class="qed"></span></a>
    <div class="nav-r">
      <a class="lnk" href="#agents">AGENTS</a>
      <a class="lnk" href="#computer">COMPUTER</a>
      <a class="lnk" href="#governance">GOVERNANCE</a>
      <button class="tgl" id="tgl" type="button" aria-label="Toggle colour theme">
        <span class="tgl-knob" aria-hidden="true"></span>
      </button>
    </div>
  </nav>

  <main id="top">
    <!-- 1 · HERO ------------------------------------------------------------ -->
    <section class="panel center void hero-void">
      {/* Interactive flowing energy field — a self-built WebGL2 shader
          (domain-warped simplex fbm + directional "raked" light + film grain,
          retinted to verdigris on green-black) behind the hero copy (z:0 inside
          the section, above the fixed #artifacts field, below .wrap at z:2). It
          scrolls away with the hero. Decorative + aria-hidden. Driven by
          initHeroField() in motion.ts, which paints one frozen frame under
          reduced motion and bails gracefully if WebGL2 is unavailable. */}
      <canvas class="hero-field" data-hero-field aria-hidden="true"></canvas>
      <div class="wrap">
        <div class="hero-mark" data-r>
          <span class="mark-big">LEMMACOMPUTER<span class="qed"></span></span>
        </div>
        {/* One <h1>. Each word is its own span so the reveal can stagger them
            (motion.ts); under reduced motion the CSS shows them at full opacity. */}
        <h1 class="serif t-hero hero-h" data-hero-h>
          <span class="hline"><span class="w">Any&nbsp;</span><span class="w">agent.</span></span>
          <span class="h-two hline"
            ><span class="w">One&nbsp;</span><span class="w">governed&nbsp;</span><span
              class="w">computer.</span
            ><span class="qed"></span></span
          >
          <!-- draw-on signature underline; a centered block just beneath the
               second line. Kept OUT of .h-two (which is overflow:hidden for the
               word-rise clip) so the stroke is never clipped. Decorative — the
               H1 text above is authoritative. -->
          <svg class="hero-sig" viewBox="0 0 300 12" fill="none" aria-hidden="true" preserveAspectRatio="none"
            ><path class="hero-sig-line" d="M2 8 C 70 4, 150 9, 230 6 S 292 6, 298 2" /></svg
          >
        </h1>
        <p class="lede" data-r style="margin-top:28px">
          Run any AI agent you want — Claude, Codex, or Hermes — on a computer your
          company can actually trust. Real desktop, real freedom to choose. The
          guardrails are already built in — no trade-off between the agent your team
          loves and the control your org requires.
        </p>
        <div class="cta-row" data-r>
          <a class="btn btn-p" href={site.githubHref} target="_blank" rel="noopener"
            >Learn more on GitHub</a
          >
          <a class="btn btn-g" href="#governance">See how it works</a>
        </div>
        <Shot
          src="workspaces.png"
          alt="The LemmaComputer dashboard listing running workspaces — My Claude and My Hermes — each showing its apps, agents, model routing, and a verified policy version."
          width={dims.workspaces.w}
          height={dims.workspaces.h}
          eager={true}
          caption="Your workspaces — apps, agents, model, and policy, per workspace"
          callouts={[
            { x: 62, y: 43, text: 'governed routing', gutter: 'r' },
            { x: 84, y: 43, text: 'policy · verified', gutter: 'r' },
          ]}
        />
      </div>
    </section>

    <!-- 1.25 · THE VILLAIN — agent sprawl (green → copper → green) --------- -->
    <!-- Names the problem upfront (adapted from the LemmaComputer social card).
         A tall scroll beat: a copper wash rises out of the green hero, holds
         behind the headline + agent chips, then fades back to green-black before
         #wall. Driven by initSprawl() (motion.ts) via a CSS-sticky stage + a
         scrubbed background layer — NO GSAP pin, so it can't overlap the
         neighbouring pins. Reduced motion / ≤900px collapse to one calm
         copper-tinted screen (CSS), and initSprawl early-returns there. The chips
         are decorative; the full problem statement lives in the aria-label + the
         visible <h2>, so nothing is lost to assistive tech. -->
    <section id="sprawl" class="void" style="height:220vh"
             aria-label="The agent era is already here: each team is bringing its own ungoverned agent. Unmanaged agents are multiplying faster than enterprises can govern them.">
      <div class="sprawl-wash" data-sprawl-wash aria-hidden="true"></div>
      <div class="sprawl-stage">
        <div class="wrap sprawl-inner" data-sprawl>
          <p class="label sprawl-kicker">THE AGENT ERA IS ALREADY HERE</p>
          <h2 class="serif t-xl sprawl-h">Each team is bringing its own ungoverned agent.</h2>
          <div class="sprawl-chips" aria-hidden="true">
            <span class="arch-chip" data-agent="claude">Claude</span>
            <span class="arch-chip" data-agent="codex">Codex</span>
            <span class="arch-chip" data-agent="hermes">Hermes</span>
            <span class="arch-chip arch-chip-ghost" data-agent="own">…+ yours</span>
          </div>
          <p class="lede sprawl-sub">Unmanaged agents are multiplying faster than enterprises can govern them.</p>
        </div>
      </div>
    </section>

    <!-- 1.5 · THE OBJECTION WALL — the emotional turn ---------------------- -->
    <!-- A pinned screen: the questions every CISO/CIO asks about agents scatter
         across the field, resolve into the one that matters, then answer to the
         product's own mechanism — the Trail — and land on the promise. Ported
         from the LemmaResearch question wall (initWall in motion.ts drives the
         scrub timeline + idle drift). The .q objections are JS-injected. Under
         reduced motion / narrow screens the CSS shows the setup lines + the
         final answer statically (no scatter). The payoff reuses the locked
         "One governed computer." string as a quiet echo beneath the answer;
         rendered in a span, not a page heading, so the single-heading QA
         contract on the hero stays intact. -->
    <section id="wall" class="void" style="height:340vh" aria-label="The questions every security team asks about AI agents — and the answer.">
      <div class="wall-stage">
        <div class="q-field" id="qField" aria-hidden="true"></div>
        <div class="wall-lines wrap">
          <h2 class="serif t-l wl" id="wl1" style="margin-bottom:6px">Agents aren't held back by capability.</h2>
          <h2 class="serif t-l wl" id="wl2" style="color:var(--v-bright)">They're held back by everything you can't answer for.</h2>
        </div>
        <div class="q-answer" id="qAns">
          <div class="a1">Every action, on the record.</div>
          <p class="after-wall">
            Every command, every file, every dollar — signed to a governed identity and
            written to a Trail you can hand an auditor. <span class="aw-echo">One governed computer.</span>
          </p>
        </div>
      </div>
    </section>

    <!-- 2 · THE ARCHITECTURE — the animated, scroll-driven hero ------------ -->
    <!-- This IS the page's centerpiece and carries the #governance anchor.
         "Swap any agent into a governed sandbox; the risky stuff is watched."
         The diagram assembles → swaps agents → runs as you scroll (motion.ts,
         initArch). Under reduced motion / narrow screens the CSS renders the
         final assembled, fully-lit state statically. The full plain-language
         story lives in the aria-label and in the annotation column below. -->
    <section class="panel void arch" id="governance">
      <div class="wrap">
        <div class="sec-head arch-head" data-r>
          <p class="label">SWAP THE AGENT · KEEP THE GUARDRAILS</p>
          <h2 class="serif t-l">Any agent you choose. Guardrails that never move.</h2>
          <p class="lede">
            Pick the agent — Claude, Codex, Hermes, or your own — and drop it into one
            governed VM sandbox with a real desktop. Everyday work just flows; the
            risky moves — reaching the web, or firing a high-risk tool — are watched
            and recorded. Scroll to watch it assemble, swap, and run.
          </p>
        </div>

        <div class="arch-stage" data-arch>
          <div
            class="arch-diagram"
            role="img"
            aria-label="How LemmaComputer works: any agent you choose — Claude, Codex, Hermes, or your own — plugs into a single governed identity socket and runs inside one governed VM sandbox built on Kasm, with a real desktop. From the running agent, an everyday action passes straight through and is written to a signed trail. A risky action — reaching the web and egress, or firing a high-risk tool or MCP action — is caught at a watched path: web and egress is filtered by an egress firewall that denies unmatched destinations, and tools and approvals holds new or changed tools until they are reviewed. Nothing crosses those paths unrecorded; before every run LemmaComputer re-checks the workspace, agent, and current policy."
          >
            <!-- LEFT · the ANY-AGENT socket (agents swap into one governed identity) -->
            <div class="arch-agents" data-arch-agents>
              <span class="arch-zone-tag mono">ANY AGENT</span>
              <div class="arch-socket" data-arch-socket>
                <span class="arch-chip" data-agent="claude">Claude</span>
                <span class="arch-chip" data-agent="codex">Codex</span>
                <span class="arch-chip" data-agent="hermes">Hermes</span>
                <span class="arch-chip arch-chip-ghost" data-agent="own">…or your own</span>
              </div>
              <span class="arch-sub mono">governed identity</span>
            </div>

            <!-- connector: agent → sandbox ("runs in") -->
            <div class="arch-edge arch-edge-in" data-edge="in" aria-hidden="true">
              <span class="arch-edge-label mono">runs in</span>
              <span class="arch-pkt arch-pkt-agent" data-pkt="agent"></span>
            </div>

            <!-- CENTER · the bold governed sandbox boundary (the star) -->
            <div class="arch-sandbox" data-arch-sandbox>
              <div class="arch-boundary" data-boundary aria-hidden="true"></div>
              <span class="arch-corner mono"
                >GOVERNED VM SANDBOX<span class="arch-corner-sub">Kasm · real desktop</span></span
              >

              <!-- the running agent inside the sandbox -->
              <div class="arch-run" data-node="run">
                <span class="arch-node-label mono">AGENT AT WORK</span>
                <span class="arch-node-sub">a real desktop, shell &amp; browser</span>
              </div>

              <!-- two actions leave the agent: everyday (verdigris) + risky (oxide) -->
              <div class="arch-flows" aria-hidden="true">
                <span class="arch-pkt arch-pkt-good" data-pkt="good"></span>
                <span class="arch-pkt arch-pkt-risk" data-pkt="risk"></span>
              </div>

              <!-- the two watched paths (risky activity is caught here) -->
              <div class="arch-watched">
                <div class="arch-node arch-node-watch" data-node="web">
                  <span class="arch-node-label mono">WEB &amp; EGRESS</span>
                  <span class="arch-node-sub"
                    >Egress firewall — deny unmatched · allow only where you say so</span
                  >
                  <span class="arch-halt" data-halt="web" aria-hidden="true">✕ stopped</span>
                </div>
                <div class="arch-node arch-node-watch" data-node="tools">
                  <span class="arch-node-label mono">TOOLS &amp; MCP ACTIONS</span>
                  <span class="arch-node-sub"
                    >Tools &amp; approvals — high-risk actions reviewed before they run</span
                  >
                  <span class="arch-halt" data-halt="tools" aria-hidden="true">✕ stopped</span>
                </div>
              </div>

              <!-- the signed trail (everything that passes is recorded) -->
              <div class="arch-node arch-node-trail" data-node="trail">
                <span class="arch-node-label mono">SIGNED TRAIL</span>
                <span class="arch-trail-row mono" data-trail-row>✓ recorded · enrolled device</span>
              </div>
            </div>
          </div>

          <!-- annotation column: the migrated plain-language governance copy -->
          <ol class="arch-notes" data-arch-notes>
            <li class="arch-note" data-note="0">
              <span class="label">SWAP ANY AGENT</span>
              <p>
                Claude, Codex, Hermes, or your own — each gets its own{' '}
                <strong>governed identity</strong>. Swap the agent; nothing else
                about the guardrails changes.
              </p>
            </li>
            <li class="arch-note" data-note="1">
              <span class="label">ONE GOVERNED SANDBOX</span>
              <p>
                The agent runs inside an isolated <strong>Kasm</strong> boundary with
                a real desktop — a Managed workspace, or a Disposable open workspace
                for non-sensitive work.
              </p>
            </li>
            <li class="arch-note" data-note="2">
              <span class="label">RISKY MOVES, CAUGHT</span>
              <p>
                Reaching the web goes through the <strong>Egress firewall</strong> (deny
                unmatched egress); high-risk tools hit <strong>Tools &amp; approvals</strong> and
                stay blocked until reviewed.
              </p>
            </li>
            <li class="arch-note" data-note="3">
              <span class="label">EVERYTHING IS RECORDED</span>
              <p>
                What passes lands in the <strong>Trail</strong>, signed by an enrolled
                device. Before every run, LemmaComputer re-checks <strong>the workspace, agent,
                and current policy</strong>.
              </p>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <!-- 3 · DESKTOP PROOF — 2 big full-Ubuntu-desktop shots ---------------- -->
    <!-- The Ubuntu desktop is the point: it shows the reader that all of this
         runs in a real VM, not a chat box. Two large standalone shots, then the
         tabbed product deck below. -->
    <section class="panel void" id="proof">
      <div class="wrap">
        <div class="sec-head" data-r>
          <p class="label">A REAL COMPUTER, NOT A CHAT BOX</p>
          <h2 class="serif t-l">Not a chat box — a whole desktop, in a VM.</h2>
          <p class="lede">
            Inside the sandbox the agent gets a real Ubuntu desktop: a browser, a
            shell, files, and apps. Here's Claude working in one — reachable as a
            native desktop app, or in the browser as <span class="mono"
              >lemmacomputer</span>.
          </p>
        </div>

        <!-- Two full-desktop shots side by side; on desktop the stage pins and
             vertical scroll pans the track from the first shot to the second
             (initProofRail). On mobile / reduced-motion the track is a native
             swipe scroller (or wraps in flow) — no pin, both shots readable. -->
        <div class="proof-stage" data-proof>
          <div class="proof-track" data-proof-track>
            <figure class="shot-desktop" data-r>
              <img
                src="/shots/claude-desktop-vm.png"
                width={dims.claudeDesktop.w}
                height={dims.claudeDesktop.h}
                loading="lazy"
                decoding="async"
                alt="The full Ubuntu desktop inside a LemmaComputer workspace — Applications and Claude in the top bar, Firefox ESR, Claude CLI, and Claude Desktop launcher icons on the wallpaper — with the Claude Desktop app open, reasoning through a live task: estimating the IRR and payback for the Jewel Changi Airport project."
              />
              <figcaption>
                Claude Desktop, running inside the governed VM — a real Ubuntu desktop,
                not a stripped-down sandbox.
              </figcaption>
            </figure>

            <figure class="shot-desktop" data-r>
              <img
                src="/shots/claude-browser-vm.png"
                width={dims.claudeBrowser.w}
                height={dims.claudeBrowser.h}
                loading="lazy"
                decoding="async"
                alt="The same governed computer reached in a browser as LemmaComputer — the Ubuntu desktop inside the workspace, with Claude's Cowork view open, pausing to ask what kind of financial model to build."
              />
              <figcaption>
                The same computer in the browser as <span class="mono"
                  >lemmacomputer</span> — every agent action still
                inside the governed workspace.
              </figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 · BRING YOUR OWN AGENT (+ the tabbed product deck) --------------- -->
    <section class="panel void" id="agents">
      <div class="wrap">
        <div class="sec-head" data-r>
          <p class="label">EVERY AGENT, ITS OWN IDENTITY</p>
          <h2 class="serif t-l">Every agent gets its own governed identity.</h2>
          <p class="lede">
            Enable Claude, OpenAI, or Hermes — desktop or CLI. Each enabled client
            receives a separate governed identity, model grant, and tool scope, so
            you can adopt a new agent without re-architecting trust. Tour the screens
            that make up the computer around it.
          </p>
        </div>

        <div class="modes" data-r aria-hidden="true">
          <span class="mode-pill">Auto</span>
          <span class="mode-pill">Lite</span>
          <span class="mode-pill">Balanced</span>
          <span class="mode-pill">Pro</span>
        </div>

        <ShotDeck shots={deckShots} />
      </div>
    </section>

    <!-- 4.5 · THE APPROVAL — a sensitive action can't approve itself. --------
         Interactive: the agent's request pauses in the governed workspace and
         is pushed to a separate approver's phone. The person taps Deny/Approve;
         the decision is signed (did:webvh + ed25519) and returned. LemmaComputer
         can verify the answer but cannot create it. All copy/state driven by
         initApprovalDemo() in motion.ts; the DOM ships in its resting state so
         it reads correctly with no JS and under reduced motion. -->
    <section class="panel void" id="approval">
      <div class="wrap">
        <div class="sec-head" data-r>
          <p class="label">SEPARATION OF DUTIES</p>
          <h2 class="serif t-l">A sensitive action shouldn't approve itself.</h2>
          <p class="lede">
            Pick something an agent wants to do, then make the call on a separate
            device. LemmaComputer pauses the action and sends it to an approver's
            phone. The phone signs the exact request — the computer can verify that
            decision, but it can never write the answer for you.
          </p>
        </div>

        <!-- Split-screen: pick a request on the LEFT (scenario cards → the
             paused action detail), decide on the approver phone on the RIGHT. -->
        <div class="approval-stage" data-r data-approval>
          <!-- LEFT — the trigger: scenario cards, then the paused action. -->
          <div class="ap-left">
            <!-- Scenario cards — choose what the agent is asking to do. -->
            <div class="approval-scenarios" role="group" aria-label="Choose a request">
              <button type="button" class="ap-chip is-active" data-scenario="export"
                aria-pressed="true">
                <span aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/></svg>
                </span>
                <small>Data</small>
                <b>Export customer report</b>
              </button>
              <button type="button" class="ap-chip" data-scenario="prod"
                aria-pressed="false">
                <span aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round"><path d="M12 2v4"/><path d="m16.24 7.76 2.83-2.83"/><path d="M18 12h4"/><path d="m16.24 16.24 2.83 2.83"/><path d="M12 18v4"/><path d="m7.76 16.24-2.83 2.83"/><path d="M6 12H2"/><path d="m7.76 7.76-2.83-2.83"/></svg>
                </span>
                <small>Deploy</small>
                <b>Change production config</b>
              </button>
              <button type="button" class="ap-chip" data-scenario="repo"
                aria-pressed="false">
                <span aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/></svg>
                </span>
                <small>Access</small>
                <b>Connect a private repo</b>
              </button>
            </div>

            <!-- The governed workspace holding the paused action. -->
            <div class="ap-request">
              <div class="ap-request-top">
                <span><i aria-hidden="true"></i> Governed workspace</span>
                <small class="mono">policy · check</small>
              </div>
              <div class="ap-request-body">
              <div class="ap-request-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </div>
              <p class="label ap-eyebrow">AGENT REQUEST · PAUSED</p>
              <h3 class="serif" data-ap-title>Export customer report</h3>
              <p class="ap-request-desc" data-ap-desc>
                Claude wants to send a sensitive file to a destination outside the
                governed workspace.
              </p>
              <div class="ap-facts">
                <span><small>Requested by</small><b data-ap-by>Research workspace</b></span>
                <span><small>Destination</small><b class="mono" data-ap-dest>external.collab</b></span>
                <span><small>Policy</small><b>An approver must decide</b></span>
                <span><small>Task digest</small><code class="mono" data-ap-digest>8F2A…9C11</code></span>
              </div>
              <div class="ap-policy">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                <span>
                  <small>WHY IT PAUSED</small>
                  <b data-ap-why>Customer data can't leave the company without a human decision.</b>
                </span>
              </div>
              <!-- Step tracker — advances as the decision travels + returns. -->
              <div class="ap-track" data-ap-track aria-hidden="true">
                <span class="is-complete"><i><span></span></i><b>Request detected</b><small>in workspace</small></span>
                <span class="is-complete"><i><span></span></i><b>Action paused</b><small>held by policy</small></span>
                <span data-step="sent"><i><span></span></i><b>Sent to approver</b><small>awaiting phone</small></span>
                <span data-step="verified"><i><span></span></i><b>Decision verified</b><small>signature checked</small></span>
              </div>
              <div class="ap-outcome" data-ap-outcome>
                <span aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                </span>
                <div>
                  <small data-ap-outcome-label>STATUS</small>
                  <b data-ap-outcome-text>Action paused · waiting for the approver</b>
                </div>
              </div>
            </div>
          </div>
          </div>

          <!-- RIGHT — the approver's phone. States swap in place. -->
          <div class="ap-phone-wrap">
            <div class="ap-phone-label">
              <span><i aria-hidden="true"></i> Approver's phone</span>
              <small class="mono">separate device</small>
            </div>
            <div class="ap-phone" data-ap-phone>
              <div class="ap-phone-status mono"><span>9:41</span><span aria-hidden="true">● ● ●</span></div>
              <div class="ap-phone-header">
                <span aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round"><path d="M12 10v4"/><path d="M12 2a3 3 0 0 0-3 3v1a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M6.5 9A3.5 3.5 0 0 0 3 12.5V15a9 9 0 0 0 18 0v-2.5A3.5 3.5 0 0 0 17.5 9"/></svg>
                </span>
                <div><b>Approver identity</b><small data-ap-phone-sub>Ready to decide</small></div>
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none"
                  stroke="var(--v-bright)" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round" aria-hidden="true"><path d="M21.801 10A10 10 0 1 1 17 3.335"/><path d="m9 11 3 3L22 4"/></svg>
              </div>

              <!-- Resting request card (default DOM state). -->
              <div class="ap-phone-request" data-ap-phone-request>
                <div class="ap-phone-req-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round"><path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M22 8c0-2.3-.8-4.3-2-6"/><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326z"/><path d="M4 2C2.8 3.7 2 5.7 2 8"/></svg>
                </div>
                <p class="label ap-eyebrow">LEMMACOMPUTER NEEDS A DECISION</p>
                <h3 class="serif" data-ap-phone-title>Export customer report</h3>
                <p class="ap-phone-desc" data-ap-phone-desc>
                  An agent wants to send a sensitive file outside the company
                  workspace.
                </p>
                <div class="ap-phone-facts">
                  <span><small>Requested by</small><b data-ap-phone-by>Research workspace</b></span>
                  <span><small>Policy</small><b>Approver must decide</b></span>
                  <span><small>Task digest</small><code class="mono" data-ap-phone-digest>8F2A…9C11</code></span>
                  <span><small>Expires</small><b>in 4 minutes</b></span>
                </div>
                <div class="ap-phone-actions">
                  <button type="button" class="ap-deny" data-ap-deny>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="2.4" stroke-linecap="round"
                      stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                    Deny
                  </button>
                  <button type="button" class="ap-approve" data-ap-approve>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="2.4" stroke-linecap="round"
                      stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    Approve
                  </button>
                </div>
              </div>

              <!-- Signed-decision result (revealed after a tap). -->
              <div class="ap-phone-result" data-ap-phone-result hidden>
                <span class="ap-phone-res-icon" aria-hidden="true" data-ap-res-icon>
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/></svg>
                </span>
                <p class="label ap-eyebrow" data-ap-res-eyebrow>DECISION SIGNED</p>
                <h3 class="serif" data-ap-res-title>Approval signed</h3>
                <p class="ap-phone-desc" data-ap-res-desc>
                  The phone signed this exact request. LemmaComputer can verify the
                  decision — it cannot change it.
                </p>
                <div class="ap-signature">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  <code class="mono">did:webvh:approver · ed25519</code>
                </div>
                <button type="button" class="ap-reset" data-ap-reset>Try another decision</button>
              </div>
              <div class="ap-home" aria-hidden="true"></div>
            </div>
          </div>
        </div>

        <!-- Principles strip — the guarantee in three beats. -->
        <div class="ap-principles" data-r>
          <span><b>PAUSE</b><small>The action can't proceed until it's decided.</small></span>
          <span><b>SIGN</b><small>The approver's phone signs the exact request.</small></span>
          <span><b>VERIFY</b><small>The computer checks the signature — it never writes it.</small></span>
        </div>
      </div>
    </section>

    <!-- 5 · IT'S A REAL COMPUTER (thin anchor → selects the Computer tab) --- -->
    <section class="panel short" id="computer">
      <div class="wrap">
        <div class="sec-head" data-r>
          <p class="label">MANAGED, OR DISPOSABLE</p>
          <h2 class="serif t-l">Managed, or disposable — your call.</h2>
          <p class="lede">
            Choose a Managed workspace — a restricted, organization-managed
            environment routed through approved models, tools, and destinations —
            or a Disposable open workspace for non-sensitive work. Either way the
            agent gets real applications: a browser locked to the governed egress
            proxy, a shell, files, and packages, all inside the isolated Kasm
            boundary.
          </p>
          <p class="lede" style="margin-top:14px">
            <a class="inline-tab-link" href="#agents" data-select-tab="computer-shot"
              >See the workspace access screen ↑</a
            >
          </p>
        </div>
      </div>
    </section>

    <!-- 6 · UNATTENDED (thin anchor → selects the Schedules tab) ----------- -->
    <section class="panel short void" id="schedules">
      <div class="wrap">
        <div class="sec-head" data-r>
          <p class="label">UNATTENDED, STILL ACCOUNTABLE</p>
          <h2 class="serif t-l">Scheduled runs re-check policy before every run.</h2>
          <p class="lede">
            Give an agent recurring work and it stays under the same rules as an
            attended session. Before every run, LemmaComputer re-checks the
            workspace, agent, and current policy — so a schedule you set months ago
            can't outrun a policy you changed yesterday.
          </p>
          <p class="lede" style="margin-top:14px">
            <a class="inline-tab-link" href="#agents" data-select-tab="schedules-shot"
              >See the schedule screen ↑</a
            >
          </p>
        </div>
      </div>
    </section>

    <!-- 7 · WHO IT'S FOR (type only) --------------------------------------- -->
    <section class="panel short" id="who">
      <div class="wrap">
        <div class="sec-head" data-r>
          <p class="label">WHO IT'S FOR</p>
          <h2 class="serif t-l">Built for the people who ship and the people who sign off.</h2>
        </div>
        <div class="cols two">
          <div class="card" data-r>
            <h3>DEVELOPERS &amp; AGENT TEAMS</h3>
            <p>
              Run the agent you actually want, with a real desktop, shell, browser,
              and files — not a stripped-down sandbox. Switch clients or model modes
              per workspace without begging for new infrastructure.
            </p>
            <span class="kicker">Freedom to choose your agent.</span>
          </div>
          <div class="card" data-r>
            <h3>PLATFORM &amp; SECURITY</h3>
            <p>
              Managed workspaces, a deny-by-default egress firewall, versioned tool
              policy, and a device-signed trail — so you can say yes to new agents
              and still answer for what they did.
            </p>
            <span class="kicker">Control that travels with the work.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 8 · CLOSE ---------------------------------------------------------- -->
    <section class="panel center void" id="close">
      <div class="wrap">
        <h2 class="serif t-xl" data-r>
          Any agent.<br /><span style="color:var(--v-bright)"
            >One governed computer.<span class="qed"></span></span
          >
        </h2>
        <p class="lede" data-r style="margin-top:24px">
          Adopt the agent your team is drawn to. Keep the governance your
          organization requires. No compromise — on one computer.
        </p>
        <div class="cta-row" data-r>
          <a class="btn btn-p" href={site.githubHref} target="_blank" rel="noopener"
            >Learn more on GitHub</a
          >
        </div>
      </div>

      <footer>
        <div class="wrap">
          <div class="foot">
            <div data-r>
              <span class="mono">LEMMACOMPUTER<span class="qed"></span></span>
              <p class="ghost-note">
                LemmaComputer is a product of LemmaLabs. Open source — the interface
                shown is real and under active development; nothing here is a
                commitment to features or availability.
              </p>
            </div>
            <div class="mono" data-r>{site.productHost}</div>
          </div>
        </div>
      </footer>
    </section>
  </main>
</BaseLayout>
